# Application Environment
NODE_ENV=development
PORT=3000

# Database Configuration
# Replace with your MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/bank

# Authentication Security
# Generate a strong random string for JWT_SECRET
JWT_SECRET=your_jwt_secret_here

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# Email Service Configuration (Optional)
# Used for registration and transaction alerts via Gmail OAuth2
EMAIL_USER=your_email@gmail.com
CLIENT_ID=your_google_client_id
CLIENT_SECRET=your_google_client_secret
REFRESH_TOKEN=your_google_refresh_token

# System Bank Account Seed (Optional)
# These credentials are used by the seed script to create a system reserve account
SYSTEM_BANK_EMAIL=system-reserve@bank.local
SYSTEM_BANK_PASSWORD=ChangeMe_System123!
SYSTEM_BANK_INITIAL_BALANCE=1000000000
